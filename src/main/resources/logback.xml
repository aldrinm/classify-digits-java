<configuration>
  <!-- Enable DEBUG or INFO for Nd4jBackend -->
  <logger name="org.nd4j.linalg.factory.Nd4jBackend" level="DEBUG" />

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
</configuration>
